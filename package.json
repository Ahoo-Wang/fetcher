{
  "name": "fetcher",
  "version": "3.18.0",
  "description": "A modern HTTP client library based on fetch API",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "integration-test"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter=./packages/* test",
    "test:it": "pnpm -r --filter=./integration-test test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "clean": "pnpm -r clean",
    "init": "sh ./scripts/init.sh",
    "update-version": "sh ./scripts/update-all-versions.sh",
    "storybook": "storybook dev --docs -p 6006",
    "build-storybook": "storybook build --docs",
    "test:storybook": "vitest run --project=storybook"
  },
  "keywords": [
    "fetcher",
    "fetch"
  ],
  "author": "Ahoo-Wang",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Ahoo-Wang/fetcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahoo-Wang/fetcher.git"
  },
  "bugs": {
    "url": "https://github.com/Ahoo-Wang/fetcher/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18.20.8"
  },
  "devDependencies": {
    "@ahoo-wang/fetcher": "workspace:*",
    "@ahoo-wang/fetcher-cosec": "workspace:*",
    "@ahoo-wang/fetcher-decorator": "workspace:*",
    "@ahoo-wang/fetcher-eventbus": "workspace:*",
    "@ahoo-wang/fetcher-eventstream": "workspace:*",
    "@ahoo-wang/fetcher-generator": "workspace:*",
    "@ahoo-wang/fetcher-openai": "workspace:*",
    "@ahoo-wang/fetcher-openapi": "workspace:*",
    "@ahoo-wang/fetcher-react": "workspace:*",
    "@ahoo-wang/fetcher-storage": "workspace:*",
    "@ahoo-wang/fetcher-viewer": "workspace:*",
    "@ahoo-wang/fetcher-wow": "workspace:*",
    "@ant-design/icons": "catalog:",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "catalog:",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "antd": "catalog:",
    "dayjs": "catalog:",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "catalog:",
    "immer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.5.10",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "catalog:",
    "vitest": "catalog:"
  }
}
