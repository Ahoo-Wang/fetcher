{
  "name": "fetcher",
  "version": "5.1.3",
  "description": "A modern HTTP client library based on fetch API",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "integration-test"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter=./packages/* test",
    "test:it": "pnpm -r --filter=./integration-test test",
    "lint": "pnpm -r lint && pnpm lint:stories",
    "lint:stories": "eslint stories .storybook scripts/verify-storybook*.mjs --max-warnings 0",
    "typecheck:stories": "tsc -p stories/tsconfig.json",
    "format": "prettier --write .",
    "clean": "pnpm -r clean",
    "init": "sh ./scripts/init.sh",
    "update-version": "sh ./scripts/update-all-versions.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --docs && node scripts/verify-storybook.mjs",
    "test:storybook": "vitest run --project=storybook",
    "eval:skills": "node scripts/eval-skills.mjs"
  },
  "keywords": [
    "fetcher",
    "fetch"
  ],
  "author": "Ahoo-Wang",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Ahoo-Wang/fetcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahoo-Wang/fetcher.git"
  },
  "bugs": {
    "url": "https://github.com/Ahoo-Wang/fetcher/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@ahoo-wang/fetcher": "workspace:*",
    "@ahoo-wang/fetcher-cosec": "workspace:*",
    "@ahoo-wang/fetcher-decorator": "workspace:*",
    "@ahoo-wang/fetcher-eventbus": "workspace:*",
    "@ahoo-wang/fetcher-eventstream": "workspace:*",
    "@ahoo-wang/fetcher-openai": "workspace:*",
    "@ahoo-wang/fetcher-openapi": "workspace:*",
    "@ahoo-wang/fetcher-react": "workspace:*",
    "@ahoo-wang/fetcher-storage": "workspace:*",
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "catalog:",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "antd": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "catalog:",
    "immer": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "catalog:",
    "vitest": "catalog:"
  }
}
